{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "elias-physics-admin.vercel.app" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/index",
      "has": [{ "type": "host", "value": "elias-physics-admin.vercel.app" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin",
      "missing": [{ "type": "host", "value": "elias-physics-admin.vercel.app" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "missing": [{ "type": "host", "value": "elias-physics-admin.vercel.app" }],
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(js|css|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
